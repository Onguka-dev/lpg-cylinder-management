# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lpg_cylinder_management?schema=public"

# Application URL
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Authentication
# This app uses the custom AUTH_SECRET session signer in lib/session-core.ts.
# Set this to a long random value in production. Do not commit real secrets.
AUTH_SECRET="replace-with-a-long-random-production-secret"
NEXTAUTH_SECRET="replace-with-a-long-random-production-secret-if-nextauth-is-added"

# Wells Gas branding
APP_BRAND_NAME="Wells Gas"
APP_COMPANY_NAME="Green Wells Energies"
NEXT_PUBLIC_APP_NAME="Wells Gas"
APP_ENV="production"
NEXT_PUBLIC_APP_ENV="production"

# Placeholder providers. Keep mock/local until live vendors are approved.
FILE_UPLOAD_PROVIDER="local-placeholder"
UPLOADS_PLACEHOLDER_PATH="./uploads"
SMS_PROVIDER="mock"
EMAIL_PROVIDER="mock"
PAYMENT_PROVIDER="mock"
MOCK_INTEGRATIONS_ENABLED="true"
