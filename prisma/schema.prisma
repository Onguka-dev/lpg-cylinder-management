generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  WAREHOUSE_MANAGER
  RSO
  MSO
  AUDITOR
  CUSTOMER
}

enum LocationType {
  HEAD_OFFICE
  WAREHOUSE
  DEPOT
  RETAIL_OUTLET
}

enum MasterDataType {
  SKU_MASTER
  CYLINDER_SIZE
  CYLINDER_CATEGORY
  PRICE
  TAX
  DISCOUNT_PROMOTION
  DELIVERY_FEE
  REGION
  ZONE
  ROUTE
  LOCATION
  WAREHOUSE
  RETAIL_OUTLET
  VEHICLE
  MAINTENANCE_LOCATION
  DAMAGED_QUARANTINE_LOCATION
  STOCK_THRESHOLD
}

enum CustomerCategory {
  DOMESTIC
  COMMERCIAL
  INDUSTRIAL
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  BLACKLISTED
}

enum CylinderStatus {
  FILLED
  EMPTY
  DAMAGED
  IN_TRANSIT
  RESERVED
  UNDER_MAINTENANCE
  WITH_CUSTOMER
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  roleId       String
  locationId   String?
  role         Role     @relation(fields: [roleId], references: [id])
  location     Location? @relation(fields: [locationId], references: [id])
  auditLogs    AuditLog[]
  cylinderHistoryEntries CylinderHistory[]
  openingBalanceBatches OpeningBalanceBatch[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Location {
  id        String       @id @default(cuid())
  name      String
  code      String       @unique
  type      LocationType
  users     User[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model LpgSku {
  id          String   @id @default(cuid())
  name        String   @unique
  capacityKg  Int
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  details   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model MasterDataRecord {
  id          String           @id @default(cuid())
  type        MasterDataType
  code        String
  name        String
  description String?
  isActive    Boolean          @default(true)
  amount      Decimal?         @db.Decimal(12, 2)
  rate        Decimal?         @db.Decimal(5, 2)
  capacityKg  Int?
  threshold   Int?
  parentId    String?
  parent      MasterDataRecord? @relation("MasterDataHierarchy", fields: [parentId], references: [id])
  children    MasterDataRecord[] @relation("MasterDataHierarchy")
  skuCylinders Cylinder[] @relation("CylinderSku")
  locationCylinders Cylinder[] @relation("CylinderLocation")
  openingBalanceSkuLines OpeningBalanceLine[] @relation("OpeningBalanceSku")
  openingBalanceLocationLines OpeningBalanceLine[] @relation("OpeningBalanceLocation")
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([type, code])
  @@index([type, isActive])
}

model Customer {
  id             String           @id @default(cuid())
  name           String
  phone          String           @unique
  proofReference String           @unique
  category       CustomerCategory
  address        String
  latitude       Decimal?         @db.Decimal(9, 6)
  longitude      Decimal?         @db.Decimal(9, 6)
  status         CustomerStatus   @default(ACTIVE)
  creditLimit    Decimal?         @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([name])
  @@index([status])
  @@index([category])
}

model Cylinder {
  id                String             @id @default(cuid())
  serialNumber      String             @unique
  barcode           String?            @unique
  skuId             String
  sku               MasterDataRecord   @relation("CylinderSku", fields: [skuId], references: [id])
  manufactureDate   DateTime?
  inspectionDueDate DateTime?
  currentLocationId String
  currentLocation   MasterDataRecord   @relation("CylinderLocation", fields: [currentLocationId], references: [id])
  status            CylinderStatus
  notes             String?
  historyEntries    CylinderHistory[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([skuId])
  @@index([currentLocationId])
  @@index([status])
}

model CylinderHistory {
  id             String          @id @default(cuid())
  cylinderId     String
  cylinder       Cylinder        @relation(fields: [cylinderId], references: [id], onDelete: Cascade)
  previousStatus CylinderStatus?
  newStatus      CylinderStatus
  previousLocationId String?
  newLocationId  String
  changedById    String?
  changedBy      User?           @relation(fields: [changedById], references: [id], onDelete: SetNull)
  reason         String
  createdAt      DateTime        @default(now())

  @@index([cylinderId])
  @@index([createdAt])
}

model OpeningBalanceBatch {
  id          String               @id @default(cuid())
  reference   String               @unique
  notes       String?
  createdById String?
  createdBy   User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines       OpeningBalanceLine[]
  createdAt   DateTime             @default(now())
}

model OpeningBalanceLine {
  id          String              @id @default(cuid())
  batchId     String
  batch       OpeningBalanceBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  skuId       String
  sku         MasterDataRecord    @relation("OpeningBalanceSku", fields: [skuId], references: [id])
  locationId  String
  location    MasterDataRecord    @relation("OpeningBalanceLocation", fields: [locationId], references: [id])
  status      CylinderStatus
  quantity    Int
  serialPrefix String
  createdAt   DateTime            @default(now())

  @@index([skuId])
  @@index([locationId])
  @@index([status])
}
