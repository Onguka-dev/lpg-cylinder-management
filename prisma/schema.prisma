generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  WAREHOUSE_MANAGER
  RSO
  MSO
  AUDITOR
  CUSTOMER
}

enum LocationType {
  HEAD_OFFICE
  WAREHOUSE
  DEPOT
  RETAIL_OUTLET
}

enum MasterDataType {
  SKU_MASTER
  CYLINDER_SIZE
  CYLINDER_CATEGORY
  PRICE
  TAX
  DISCOUNT_PROMOTION
  DELIVERY_FEE
  REGION
  ZONE
  ROUTE
  LOCATION
  WAREHOUSE
  RETAIL_OUTLET
  VEHICLE
  MAINTENANCE_LOCATION
  DAMAGED_QUARANTINE_LOCATION
  STOCK_THRESHOLD
}

enum CustomerCategory {
  DOMESTIC
  COMMERCIAL
  INDUSTRIAL
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  BLACKLISTED
}

enum CylinderStatus {
  FILLED
  EMPTY
  DAMAGED
  IN_TRANSIT
  RESERVED
  UNDER_MAINTENANCE
  WITH_CUSTOMER
}

enum InventoryMovementType {
  OPENING_BALANCE
  RECEIPT
  ISSUE
  TRANSFER
  RETURN_FROM_CUSTOMER
  RETURN_FROM_VEHICLE
  ADJUSTMENT
  DAMAGED_QUARANTINE
  MAINTENANCE_TRANSFER
}

enum InventoryMovementStatus {
  REQUESTED
  APPROVED
  DISPATCHED
  RECEIVED
  COMPLETED
  VARIANCE_LOGGED
  REJECTED
}

enum RefillOrderStatus {
  DRAFT
  CLOSED
  CANCELLED
}

enum PaymentMethod {
  CASH
  MPESA
  CARD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  FAILED
  REFUNDED
}

enum InvoiceSourceType {
  CUSTOMER_ORDER
  RETAIL_REFILL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum OrderChannel {
  MOBILE_APP
  WEB
  RSO
  MSO
  CALL_CENTRE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  ASSIGNED
  DISPATCHED
  DELIVERED
  CLOSED
  CANCELLED
}

enum FieldSaleStatus {
  CLOSED
  DISCREPANCY_REPORTED
}

enum DeliveryStatus {
  ASSIGNED
  LOADING_CONFIRMED
  CUSTOMER_ARRIVAL
  DELIVERED
  FAILED
  RETURNED
  EXCEPTION
}

enum FailedDeliveryReason {
  CUSTOMER_UNAVAILABLE
  DAMAGED_CYLINDER
  WRONG_LOCATION
  PAYMENT_ISSUE
  PARTIAL_DELIVERY
}

enum ReconciliationScope {
  RSO
  MSO
  WAREHOUSE
}

enum ReconciliationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
}

enum CylinderMaintenanceStatus {
  NONE
  OPEN
  IN_PROGRESS
  CLEARED
  SCRAP_PLACEHOLDER
}

enum MaintenanceCaseStatus {
  OPEN
  INSPECTION_RECORDED
  QUARANTINED
  APPROVED_RETURN_TO_STOCK
  SCRAP_PLACEHOLDER
  CLOSED
}

enum InspectionResult {
  PASSED
  FAILED
  NEEDS_HYDRO_TEST
  UNSAFE
}

enum SafetyIncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  roleId       String
  locationId   String?
  role         Role     @relation(fields: [roleId], references: [id])
  location     Location? @relation(fields: [locationId], references: [id])
  auditLogs    AuditLog[]
  cylinderHistoryEntries CylinderHistory[]
  openingBalanceBatches OpeningBalanceBatch[]
  requestedInventoryMovements InventoryMovement[] @relation("MovementRequestedBy")
  approvedInventoryMovements InventoryMovement[] @relation("MovementApprovedBy")
  dispatchedInventoryMovements InventoryMovement[] @relation("MovementDispatchedBy")
  receivedInventoryMovements InventoryMovement[] @relation("MovementReceivedBy")
  inventoryMovementHistoryEntries InventoryMovementHistory[]
  refillOrders RefillOrder[]
  refillPayments Payment[]
  customerOrders CustomerOrder[]
  customerOrderHistoryEntries CustomerOrderHistory[]
  fieldSales FieldSale[]
  assignedDeliveries Delivery[] @relation("DeliveryAssignedUser")
  createdDeliveries Delivery[] @relation("DeliveryCreatedBy")
  deliveryHistoryEntries DeliveryHistory[]
  createdInvoices Invoice[] @relation("InvoiceCreatedBy")
  recordedBillingPayments BillingPayment[] @relation("BillingPaymentRecordedBy")
  reconciliations DailyReconciliation[] @relation("ReconciliationOwner")
  createdReconciliations DailyReconciliation[] @relation("ReconciliationCreatedBy")
  reviewedReconciliations DailyReconciliation[] @relation("ReconciliationReviewedBy")
  createdMaintenanceCases MaintenanceCase[] @relation("MaintenanceCaseCreatedBy")
  inspectedMaintenanceCases MaintenanceCase[] @relation("MaintenanceCaseInspectedBy")
  approvedMaintenanceCases MaintenanceCase[] @relation("MaintenanceCaseApprovedBy")
  createdSafetyIncidents SafetyIncident[] @relation("SafetyIncidentCreatedBy")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Location {
  id        String       @id @default(cuid())
  name      String
  code      String       @unique
  type      LocationType
  users     User[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model LpgSku {
  id          String   @id @default(cuid())
  name        String   @unique
  capacityKg  Int
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  details   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model MasterDataRecord {
  id          String           @id @default(cuid())
  type        MasterDataType
  code        String
  name        String
  description String?
  isActive    Boolean          @default(true)
  amount      Decimal?         @db.Decimal(12, 2)
  rate        Decimal?         @db.Decimal(5, 2)
  capacityKg  Int?
  threshold   Int?
  parentId    String?
  parent      MasterDataRecord? @relation("MasterDataHierarchy", fields: [parentId], references: [id])
  children    MasterDataRecord[] @relation("MasterDataHierarchy")
  skuCylinders Cylinder[] @relation("CylinderSku")
  locationCylinders Cylinder[] @relation("CylinderLocation")
  openingBalanceSkuLines OpeningBalanceLine[] @relation("OpeningBalanceSku")
  openingBalanceLocationLines OpeningBalanceLine[] @relation("OpeningBalanceLocation")
  movementSkus InventoryMovement[] @relation("MovementSku")
  sourceMovements InventoryMovement[] @relation("MovementSourceLocation")
  destinationMovements InventoryMovement[] @relation("MovementDestinationLocation")
  refillOrderSkus RefillOrder[] @relation("RefillOrderSku")
  refillOrderLocations RefillOrder[] @relation("RefillOrderLocation")
  orderDeliveryZones CustomerOrder[] @relation("OrderDeliveryZone")
  orderItemSkus CustomerOrderItem[] @relation("OrderItemSku")
  fieldSaleSkus FieldSale[] @relation("FieldSaleSku")
  fieldSaleVehicles FieldSale[] @relation("FieldSaleVehicle")
  fieldSaleRoutes FieldSale[] @relation("FieldSaleRoute")
  fieldSaleZones FieldSale[] @relation("FieldSaleZone")
  deliveryRoutes Delivery[] @relation("DeliveryRoute")
  deliveryZones Delivery[] @relation("DeliveryZone")
  deliveryVehicles Delivery[] @relation("DeliveryVehicle")
  reconciliationLocations DailyReconciliation[] @relation("ReconciliationLocation")
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([type, code])
  @@index([type, isActive])
}

model Customer {
  id             String           @id @default(cuid())
  name           String
  phone          String           @unique
  proofReference String           @unique
  category       CustomerCategory
  address        String
  latitude       Decimal?         @db.Decimal(9, 6)
  longitude      Decimal?         @db.Decimal(9, 6)
  status         CustomerStatus   @default(ACTIVE)
  creditLimit    Decimal?         @db.Decimal(12, 2)
  notes          String?
  refillOrders   RefillOrder[]
  customerOrders CustomerOrder[]
  fieldSales FieldSale[]
  invoices       Invoice[]
  billingPayments BillingPayment[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([name])
  @@index([status])
  @@index([category])
}

model CustomerOrder {
  id                   String                @id @default(cuid())
  orderNumber          String                @unique
  customerId           String
  customer             Customer              @relation(fields: [customerId], references: [id])
  status               OrderStatus           @default(PENDING)
  channel              OrderChannel
  isPriority           Boolean               @default(false)
  deliveryZoneId       String?
  deliveryZone         MasterDataRecord?     @relation("OrderDeliveryZone", fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  expectedDeliveryDate DateTime?
  notes                String?
  deliveryPlaceholder  String?
  createdById          String?
  createdBy            User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items                CustomerOrderItem[]
  historyEntries       CustomerOrderHistory[]
  delivery             Delivery?
  invoice              Invoice?              @relation("OrderInvoice")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([channel])
  @@index([isPriority])
  @@index([deliveryZoneId])
}

model CustomerOrderItem {
  id        String           @id @default(cuid())
  orderId   String
  order     CustomerOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  skuId     String
  sku       MasterDataRecord @relation("OrderItemSku", fields: [skuId], references: [id])
  quantity  Int
  notes     String?
  createdAt DateTime         @default(now())

  @@index([orderId])
  @@index([skuId])
}

model CustomerOrderHistory {
  id          String       @id @default(cuid())
  orderId     String
  order       CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  action      String
  details     String
  changedById String?
  changedBy   User?        @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model Delivery {
  id                   String                @id @default(cuid())
  deliveryNumber       String                @unique
  orderId              String                @unique
  order                CustomerOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  routeId              String?
  route                MasterDataRecord?     @relation("DeliveryRoute", fields: [routeId], references: [id], onDelete: SetNull)
  zoneId               String?
  zone                 MasterDataRecord?     @relation("DeliveryZone", fields: [zoneId], references: [id], onDelete: SetNull)
  vehicleId            String?
  vehicle              MasterDataRecord?     @relation("DeliveryVehicle", fields: [vehicleId], references: [id], onDelete: SetNull)
  assignedUserId       String?
  assignedUser         User?                 @relation("DeliveryAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  driverName           String?
  status               DeliveryStatus        @default(ASSIGNED)
  failedReason         FailedDeliveryReason?
  otp                  String?
  signaturePlaceholder String?
  photoPlaceholder     String?
  gpsLatitude          Decimal?              @db.Decimal(9, 6)
  gpsLongitude         Decimal?              @db.Decimal(9, 6)
  customerRemarks      String?
  exceptionNotes       String?
  loadingConfirmedAt   DateTime?
  customerArrivedAt    DateTime?
  deliveredAt          DateTime?
  failedAt             DateTime?
  returnedAt           DateTime?
  createdById          String?
  createdBy            User?                 @relation("DeliveryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  historyEntries       DeliveryHistory[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([status])
  @@index([routeId])
  @@index([zoneId])
  @@index([vehicleId])
  @@index([assignedUserId])
}

model DeliveryHistory {
  id           String          @id @default(cuid())
  deliveryId   String
  delivery     Delivery        @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  fromStatus   DeliveryStatus?
  toStatus     DeliveryStatus
  action       String
  details      String
  changedById  String?
  changedBy    User?           @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())

  @@index([deliveryId])
  @@index([createdAt])
}

model Cylinder {
  id                String             @id @default(cuid())
  serialNumber      String             @unique
  barcode           String?            @unique
  skuId             String
  sku               MasterDataRecord   @relation("CylinderSku", fields: [skuId], references: [id])
  manufactureDate   DateTime?
  inspectionDueDate DateTime?
  currentLocationId String
  currentLocation   MasterDataRecord   @relation("CylinderLocation", fields: [currentLocationId], references: [id])
  status            CylinderStatus
  notes             String?
  historyEntries    CylinderHistory[]
  movementLines     InventoryMovementCylinder[]
  filledRefillOrders RefillOrder[] @relation("FilledRefillCylinder")
  emptyReturnRefillOrders RefillOrder[] @relation("EmptyReturnCylinder")
  fieldFilledSales FieldSale[] @relation("FieldFilledCylinder")
  fieldEmptyReturns FieldSale[] @relation("FieldEmptyCylinder")
  expiryDate        DateTime?
  hydroTestDueDate  DateTime?
  unsafeStatus      Boolean            @default(false)
  quarantinedStatus Boolean            @default(false)
  maintenanceStatus CylinderMaintenanceStatus @default(NONE)
  maintenanceCases  MaintenanceCase[]
  safetyIncidents   SafetyIncident[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([skuId])
  @@index([currentLocationId])
  @@index([status])
  @@index([unsafeStatus])
  @@index([quarantinedStatus])
  @@index([maintenanceStatus])
  @@index([expiryDate])
  @@index([hydroTestDueDate])
}

model MaintenanceCase {
  id                         String                 @id @default(cuid())
  caseNumber                 String                 @unique
  cylinderId                 String
  cylinder                   Cylinder               @relation(fields: [cylinderId], references: [id], onDelete: Cascade)
  status                     MaintenanceCaseStatus  @default(OPEN)
  reason                     String
  inspectionResult           InspectionResult?
  inspectionNotes            String?
  quarantineMovementId       String?
  returnApprovalNotes        String?
  scrapWriteOffPlaceholder   String?
  certificateUploadPlaceholder String?
  documentUploadPlaceholder  String?
  createdById                String?
  createdBy                  User?                  @relation("MaintenanceCaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  inspectedById              String?
  inspectedBy                User?                  @relation("MaintenanceCaseInspectedBy", fields: [inspectedById], references: [id], onDelete: SetNull)
  approvedById               String?
  approvedBy                 User?                  @relation("MaintenanceCaseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  inspectedAt                DateTime?
  quarantinedAt              DateTime?
  approvedAt                 DateTime?
  closedAt                   DateTime?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  @@index([cylinderId])
  @@index([status])
  @@index([inspectionResult])
}

model SafetyIncident {
  id                           String                 @id @default(cuid())
  incidentNumber               String                 @unique
  cylinderId                   String?
  cylinder                     Cylinder?              @relation(fields: [cylinderId], references: [id], onDelete: SetNull)
  title                        String
  severity                     SafetyIncidentSeverity
  incidentDate                 DateTime
  locationId                   String?
  description                  String
  correctiveAction             String?
  certificateUploadPlaceholder String?
  photoUploadPlaceholder       String?
  createdById                  String?
  createdBy                    User?                  @relation("SafetyIncidentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt

  @@index([cylinderId])
  @@index([severity])
  @@index([incidentDate])
}

model FieldSale {
  id                    String          @id @default(cuid())
  saleNumber            String          @unique
  customerId            String
  customer              Customer        @relation(fields: [customerId], references: [id])
  skuId                 String
  sku                   MasterDataRecord @relation("FieldSaleSku", fields: [skuId], references: [id])
  vehicleId             String
  vehicle               MasterDataRecord @relation("FieldSaleVehicle", fields: [vehicleId], references: [id])
  routeId               String?
  route                 MasterDataRecord? @relation("FieldSaleRoute", fields: [routeId], references: [id], onDelete: SetNull)
  zoneId                String?
  zone                  MasterDataRecord? @relation("FieldSaleZone", fields: [zoneId], references: [id], onDelete: SetNull)
  filledCylinderId      String
  filledCylinder        Cylinder        @relation("FieldFilledCylinder", fields: [filledCylinderId], references: [id])
  emptyReturnCylinderId String
  emptyReturnCylinder   Cylinder        @relation("FieldEmptyCylinder", fields: [emptyReturnCylinderId], references: [id])
  paymentMethod         PaymentMethod
  paymentReference      String?
  amount                Decimal         @db.Decimal(12, 2)
  deliveryStatus        String
  discrepancyReport     String?
  offlineSyncPlaceholder String?
  status                FieldSaleStatus @default(CLOSED)
  createdById           String?
  createdBy             User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([customerId])
  @@index([skuId])
  @@index([vehicleId])
  @@index([routeId])
  @@index([zoneId])
  @@index([status])
}

model RefillOrder {
  id                    String            @id @default(cuid())
  orderNumber           String            @unique
  customerId            String
  customer              Customer          @relation(fields: [customerId], references: [id])
  skuId                 String
  sku                   MasterDataRecord  @relation("RefillOrderSku", fields: [skuId], references: [id])
  locationId            String
  location              MasterDataRecord  @relation("RefillOrderLocation", fields: [locationId], references: [id])
  filledCylinderId      String
  filledCylinder        Cylinder          @relation("FilledRefillCylinder", fields: [filledCylinderId], references: [id])
  emptyReturnCylinderId String
  emptyReturnCylinder   Cylinder          @relation("EmptyReturnCylinder", fields: [emptyReturnCylinderId], references: [id])
  status                RefillOrderStatus @default(DRAFT)
  paymentMethod         PaymentMethod
  subtotalAmount        Decimal           @db.Decimal(12, 2)
  taxAmount             Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount           Decimal           @db.Decimal(12, 2)
  invoiceNumber         String            @unique
  receiptNumber         String            @unique
  notes                 String?
  deliveryPlaceholder   String?
  creditPlaceholder     String?
  createdById           String?
  createdBy             User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  payment               Payment?
  invoice               Invoice?             @relation("RefillInvoice")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([customerId])
  @@index([skuId])
  @@index([locationId])
  @@index([status])
}

model Payment {
  id            String        @id @default(cuid())
  paymentNumber String       @unique
  orderId       String       @unique
  order         RefillOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  status        PaymentStatus @default(PAID)
  amount        Decimal       @db.Decimal(12, 2)
  reference     String?
  recordedById  String?
  recordedBy    User?         @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())

  @@index([method])
  @@index([status])
}

model Invoice {
  id                    String            @id @default(cuid())
  invoiceNumber         String            @unique
  sourceType            InvoiceSourceType
  customerId            String
  customer              Customer          @relation(fields: [customerId], references: [id])
  customerOrderId       String?           @unique
  customerOrder         CustomerOrder?    @relation("OrderInvoice", fields: [customerOrderId], references: [id], onDelete: SetNull)
  refillOrderId         String?           @unique
  refillOrder           RefillOrder?      @relation("RefillInvoice", fields: [refillOrderId], references: [id], onDelete: SetNull)
  status                InvoiceStatus     @default(ISSUED)
  subtotalAmount        Decimal           @db.Decimal(12, 2)
  taxAmount             Decimal           @default(0) @db.Decimal(12, 2)
  deliveryFeeAmount     Decimal           @default(0) @db.Decimal(12, 2)
  discountAmount        Decimal           @default(0) @db.Decimal(12, 2)
  promotionPlaceholder  String?
  totalAmount           Decimal           @db.Decimal(12, 2)
  amountPaid            Decimal           @default(0) @db.Decimal(12, 2)
  balanceAmount         Decimal           @db.Decimal(12, 2)
  creditLimitChecked    Boolean           @default(false)
  creditLimitExceeded   Boolean           @default(false)
  refundPlaceholder     String?
  notes                 String?
  createdById           String?
  createdBy             User?             @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines                 InvoiceLine[]
  payments              BillingPayment[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([sourceType])
  @@index([customerId])
  @@index([status])
}

model InvoiceLine {
  id          String    @id @default(cuid())
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitAmount  Decimal   @db.Decimal(12, 2)
  lineTotal   Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())

  @@index([invoiceId])
}

model BillingPayment {
  id                String        @id @default(cuid())
  receiptNumber     String        @unique
  invoiceId         String
  invoice           Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer      @relation(fields: [customerId], references: [id])
  method            PaymentMethod
  status            PaymentStatus @default(PAID)
  amount            Decimal       @db.Decimal(12, 2)
  reference         String?
  refundPlaceholder String?
  recordedById      String?
  recordedBy        User?         @relation("BillingPaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())

  @@index([invoiceId])
  @@index([customerId])
  @@index([method])
  @@index([status])
}

model DailyReconciliation {
  id                    String                @id @default(cuid())
  reference             String                @unique
  reconciliationDate    DateTime
  scope                 ReconciliationScope
  status                ReconciliationStatus  @default(DRAFT)
  ownerId               String
  owner                 User                  @relation("ReconciliationOwner", fields: [ownerId], references: [id])
  locationId            String?
  location              MasterDataRecord?     @relation("ReconciliationLocation", fields: [locationId], references: [id], onDelete: SetNull)
  openingStock          Int                   @default(0)
  goodsReceived         Int                   @default(0)
  salesIssues           Int                   @default(0)
  transfers             Int                   @default(0)
  returns               Int                   @default(0)
  damagedCylinders      Int                   @default(0)
  expectedClosingStock  Int                   @default(0)
  actualClosingStock    Int                   @default(0)
  stockVariance         Int                   @default(0)
  stockExplanation      String?
  cashCollections       Decimal               @default(0) @db.Decimal(12, 2)
  mpesaCollections      Decimal               @default(0) @db.Decimal(12, 2)
  cardCollections       Decimal               @default(0) @db.Decimal(12, 2)
  expectedCash          Decimal               @default(0) @db.Decimal(12, 2)
  actualCash            Decimal               @default(0) @db.Decimal(12, 2)
  paymentVariance       Decimal               @default(0) @db.Decimal(12, 2)
  paymentExplanation    String?
  supervisorNotes       String?
  adminOverrideReason   String?
  createdById           String?
  createdBy             User?                 @relation("ReconciliationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedById          String?
  reviewedBy            User?                 @relation("ReconciliationReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  submittedAt           DateTime?
  approvedAt            DateTime?
  returnedAt            DateTime?
  lockedAt              DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([ownerId, reconciliationDate, scope])
  @@index([status])
  @@index([scope])
  @@index([reconciliationDate])
  @@index([locationId])
}

model InventoryMovement {
  id                    String                  @id @default(cuid())
  reference             String                  @unique
  type                  InventoryMovementType
  status                InventoryMovementStatus @default(REQUESTED)
  skuId                 String
  sku                   MasterDataRecord        @relation("MovementSku", fields: [skuId], references: [id])
  sourceLocationId      String?
  sourceLocation        MasterDataRecord?       @relation("MovementSourceLocation", fields: [sourceLocationId], references: [id])
  destinationLocationId String?
  destinationLocation   MasterDataRecord?       @relation("MovementDestinationLocation", fields: [destinationLocationId], references: [id])
  sourceStatus          CylinderStatus?
  destinationStatus     CylinderStatus
  requestedQuantity     Int
  approvedQuantity      Int?
  dispatchedQuantity    Int?
  receivedQuantity      Int?
  varianceQuantity      Int?
  varianceReason        String?
  notes                 String?
  requestedById         String?
  requestedBy           User?                   @relation("MovementRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedById          String?
  approvedBy            User?                   @relation("MovementApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  dispatchedById        String?
  dispatchedBy          User?                   @relation("MovementDispatchedBy", fields: [dispatchedById], references: [id], onDelete: SetNull)
  receivedById          String?
  receivedBy            User?                   @relation("MovementReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  approvedAt            DateTime?
  dispatchedAt          DateTime?
  receivedAt            DateTime?
  completedAt           DateTime?
  cylinders             InventoryMovementCylinder[]
  historyEntries        InventoryMovementHistory[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([type])
  @@index([status])
  @@index([skuId])
  @@index([sourceLocationId])
  @@index([destinationLocationId])
}

model InventoryMovementCylinder {
  id         String            @id @default(cuid())
  movementId String
  movement   InventoryMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  cylinderId String
  cylinder   Cylinder          @relation(fields: [cylinderId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())

  @@unique([movementId, cylinderId])
  @@index([cylinderId])
}

model InventoryMovementHistory {
  id         String                   @id @default(cuid())
  movementId String
  movement   InventoryMovement        @relation(fields: [movementId], references: [id], onDelete: Cascade)
  fromStatus InventoryMovementStatus?
  toStatus   InventoryMovementStatus
  action     String
  details    String
  changedById String?
  changedBy  User?                    @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt  DateTime                 @default(now())

  @@index([movementId])
  @@index([createdAt])
}

model CylinderHistory {
  id             String          @id @default(cuid())
  cylinderId     String
  cylinder       Cylinder        @relation(fields: [cylinderId], references: [id], onDelete: Cascade)
  previousStatus CylinderStatus?
  newStatus      CylinderStatus
  previousLocationId String?
  newLocationId  String
  changedById    String?
  changedBy      User?           @relation(fields: [changedById], references: [id], onDelete: SetNull)
  reason         String
  createdAt      DateTime        @default(now())

  @@index([cylinderId])
  @@index([createdAt])
}

model OpeningBalanceBatch {
  id          String               @id @default(cuid())
  reference   String               @unique
  notes       String?
  createdById String?
  createdBy   User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines       OpeningBalanceLine[]
  createdAt   DateTime             @default(now())
}

model OpeningBalanceLine {
  id          String              @id @default(cuid())
  batchId     String
  batch       OpeningBalanceBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  skuId       String
  sku         MasterDataRecord    @relation("OpeningBalanceSku", fields: [skuId], references: [id])
  locationId  String
  location    MasterDataRecord    @relation("OpeningBalanceLocation", fields: [locationId], references: [id])
  status      CylinderStatus
  quantity    Int
  serialPrefix String
  createdAt   DateTime            @default(now())

  @@index([skuId])
  @@index([locationId])
  @@index([status])
}
