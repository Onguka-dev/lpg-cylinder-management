  expectedReceiptAt     DateTime?
  requestedById         String?
  requestedBy           User?                       @relation("MovementRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedById          String?
  approvedBy            User?                       @relation("MovementApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  dispatchedById        String?
  dispatchedBy          User?                       @relation("MovementDispatchedBy", fields: [dispatchedById], references: [id], onDelete: SetNull)
  receivedById          String?
  receivedBy            User?                       @relation("MovementReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  approvedAt            DateTime?
  dispatchedAt          DateTime?
  receivedAt            DateTime?
  completedAt           DateTime?
  sapDocumentNo         String?
  cylinders             InventoryMovementCylinder[]
  historyEntries        InventoryMovementHistory[]
  reconciliationVarianceCases ReconciliationVarianceCase[]
  supplierReceiptLines  SupplierReceiptLine[]
  plantTransfers        PlantTransfer[]
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  @@index([type])
  @@index([status])
  @@index([skuId])
  @@index([sourceLocationId])
  @@index([destinationLocationId])
}

model InventoryMovementCylinder {
  id         String            @id @default(cuid())
  movementId String
  movement   InventoryMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  cylinderId String
  cylinder   Cylinder          @relation(fields: [cylinderId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())

  @@unique([movementId, cylinderId])
  @@index([cylinderId])
}

model InventoryMovementHistory {
  id          String                   @id @default(cuid())
  movementId  String
  movement    InventoryMovement        @relation(fields: [movementId], references: [id], onDelete: Cascade)
  fromStatus  InventoryMovementStatus?
  toStatus    InventoryMovementStatus
  action      String
  details     String
  changedById String?
  changedBy   User?                    @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime                 @default(now())

  @@index([movementId])
  @@index([createdAt])
}

model SupplierReceipt {
  id                     String                @id @default(cuid())
  reference              String                @unique
  warehouseId            String
  warehouse              MasterDataRecord      @relation("SupplierReceiptWarehouse", fields: [warehouseId], references: [id])
  supplierManufacturer   String
  purchaseOrderReference String
  deliveryNote           String?
  vehicleTruckNumber     String?
  receiptDateTime        DateTime
  receivedByName         String
  remarks                String?
  attachmentPlaceholder  String?
  status                 SupplierReceiptStatus @default(DRAFT)
  createdById            String?
  createdBy              User?                 @relation("SupplierReceiptCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedById           String?
  reviewedBy             User?                 @relation("SupplierReceiptReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  postedById             String?
  postedBy               User?                 @relation("SupplierReceiptPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  reviewedAt             DateTime?
  postedAt               DateTime?
  sapDocumentNo          String?
  lines                  SupplierReceiptLine[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([warehouseId])
  @@index([status])
  @@index([receiptDateTime])
  @@index([createdById])
}

model SupplierReceiptLine {
  id                  String                   @id @default(cuid())
  receiptId           String
  receipt             SupplierReceipt          @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  cylinderSizeKg      Int
  factorySerialNo     String                   @unique
  barcode             String                   @unique
  qrCode              String?
  manufacturer        String
  manufactureDate     DateTime?
  condition           SupplierReceiptCondition
  cylinderId          String?
  cylinder            Cylinder?                @relation(fields: [cylinderId], references: [id], onDelete: SetNull)
  inventoryMovementId String?
  inventoryMovement   InventoryMovement?       @relation(fields: [inventoryMovementId], references: [id], onDelete: SetNull)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([receiptId])
  @@index([cylinderSizeKg])
  @@index([condition])
  @@index([cylinderId])
  @@index([inventoryMovementId])
}

model PlantTransfer {
  id                   String              @id @default(cuid())
  reference            String              @unique
  status               PlantTransferStatus @default(DRAFT)
  sourceLocationId     String
  sourceLocation       MasterDataRecord    @relation("PlantTransferSourceLocation", fields: [sourceLocationId], references: [id])
  plantLocationId      String
  plantLocation        MasterDataRecord    @relation("PlantTransferPlantLocation", fields: [plantLocationId], references: [id])
  returnDestinationId  String
  returnDestination    MasterDataRecord    @relation("PlantTransferReturnDestination", fields: [returnDestinationId], references: [id])
  vehicle              String
  driver               String
  sealNumber           String
  dispatchNote         String?
  expectedReceiptTime  DateTime?
  remarks              String?
  dispatchMovementId   String?
  dispatchMovement     InventoryMovement?  @relation(fields: [dispatchMovementId], references: [id], onDelete: SetNull)
  returnMovementId     String?
  createdById          String?
  createdBy            User?               @relation("PlantTransferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  dispatchedById       String?
  dispatchedBy         User?               @relation("PlantTransferDispatchedBy", fields: [dispatchedById], references: [id], onDelete: SetNull)
  plantReceivedById    String?
  plantReceivedBy      User?               @relation("PlantTransferReceivedBy", fields: [plantReceivedById], references: [id], onDelete: SetNull)
  returnDispatchedById String?
  returnDispatchedBy   User?               @relation("PlantTransferReturnDispatchedBy", fields: [returnDispatchedById], references: [id], onDelete: SetNull)
  returnReceivedById   String?
  returnReceivedBy     User?               @relation("PlantTransferReturnReceivedBy", fields: [returnReceivedById], references: [id], onDelete: SetNull)
  dispatchedAt         DateTime?
  plantReceivedAt      DateTime?
  returnDispatchedAt   DateTime?
  returnReceivedAt     DateTime?
  lines                PlantTransferLine[]
  refillBatches        RefillBatch[]
  varianceCases        PlantVarianceCase[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([status])
  @@index([sourceLocationId])
  @@index([plantLocationId])
  @@index([returnDestinationId])
  @@index([dispatchMovementId])
  @@index([createdAt])
}

model PlantTransferLine {
  id               String                  @id @default(cuid())
  transferId       String
  transfer         PlantTransfer           @relation(fields: [transferId], references: [id], onDelete: Cascade)
  cylinderId       String
  cylinder         Cylinder                @relation(fields: [cylinderId], references: [id], onDelete: Cascade)
  status           PlantTransferLineStatus @default(EXPECTED)
  receivedAt       DateTime?
  returnReceivedAt DateTime?
  remarks          String?
  refillBatchLines RefillBatchLine[]
  varianceCases    PlantVarianceCase[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([transferId, cylinderId])
  @@index([cylinderId])
  @@index([status])
}

model RefillBatch {
  id                      String                  @id @default(cuid())
  reference               String                  @unique
  transferId              String
  transfer                PlantTransfer           @relation(fields: [transferId], references: [id], onDelete: Cascade)
  plantLocationId         String
  plantLocation           MasterDataRecord        @relation("RefillBatchPlantLocation", fields: [plantLocationId], references: [id])
  status                  RefillBatchStatus       @default(DRAFT)
  qualityInspectionStatus QualityInspectionStatus @default(PENDING)
  qualityNotes            String?
  createdById             String?
  createdBy               User?                   @relation("RefillBatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  qualityCheckedById      String?
  qualityCheckedBy        User?                   @relation("RefillBatchQualityCheckedBy", fields: [qualityCheckedById], references: [id], onDelete: SetNull)
  qualityCheckedAt        DateTime?
  filledAt                DateTime?
  lines                   RefillBatchLine[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([transferId])
  @@index([plantLocationId])
  @@index([status])
  @@index([qualityInspectionStatus])
}

model RefillBatchLine {
  id             String            @id @default(cuid())
  batchId        String
  batch          RefillBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  transferLineId String
  transferLine   PlantTransferLine @relation(fields: [transferLineId], references: [id], onDelete: Cascade)
  cylinderId     String
  cylinder       Cylinder          @relation(fields: [cylinderId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())

  @@unique([batchId, cylinderId])
  @@unique([transferLineId])
  @@index([cylinderId])
}

model PlantVarianceCase {
  id             String              @id @default(cuid())
  reference      String              @unique
  transferId     String
  transfer       PlantTransfer       @relation(fields: [transferId], references: [id], onDelete: Cascade)
  transferLineId String?
  transferLine   PlantTransferLine?  @relation(fields: [transferLineId], references: [id], onDelete: SetNull)
  cylinderId     String?
  cylinder       Cylinder?           @relation(fields: [cylinderId], references: [id], onDelete: SetNull)
  type           PlantVarianceType
  status         PlantVarianceStatus @default(OPEN)
  details        String
  createdById    String?
  createdBy      User?               @relation("PlantVarianceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([transferId])
  @@index([transferLineId])
  @@index([cylinderId])
  @@index([type])
  @@index([status])
}

model CylinderHistory {
  id                 String          @id @default(cuid())
  cylinderId         String
  cylinder           Cylinder        @relation(fields: [cylinderId], references: [id], onDelete: Cascade)
  previousStatus     CylinderStatus?
  newStatus          CylinderStatus
  previousLocationId String?
  newLocationId      String
  changedById        String?
  changedBy          User?           @relation(fields: [changedById], references: [id], onDelete: SetNull)
  reason             String
  createdAt          DateTime        @default(now())

  @@index([cylinderId])
  @@index([createdAt])
}

model OpeningBalanceBatch {
  id          String               @id @default(cuid())
  reference   String               @unique
  notes       String?
  createdById String?
  createdBy   User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines       OpeningBalanceLine[]
  createdAt   DateTime             @default(now())
}

model OpeningBalanceLine {
  id           String              @id @default(cuid())
  batchId      String
  batch        OpeningBalanceBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  skuId        String
  sku          MasterDataRecord    @relation("OpeningBalanceSku", fields: [skuId], references: [id])
  locationId   String
  location     MasterDataRecord    @relation("OpeningBalanceLocation", fields: [locationId], references: [id])
  status       CylinderStatus
  quantity     Int
  serialPrefix String
  createdAt    DateTime            @default(now())

  @@index([skuId])
  @@index([locationId])
  @@index([status])
}
