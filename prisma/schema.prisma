generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  WAREHOUSE_MANAGER
  PLANT_MANAGER
  RSO
  MSO
  SERVICE_CENTRE_STAFF
  FINANCE_SAP_REVIEWER
  AUDITOR
  CUSTOMER
}

enum LocationType {
  HEAD_OFFICE
  WAREHOUSE
  DEPOT
  RETAIL_OUTLET
}

enum MasterDataType {
  SKU_MASTER
  CYLINDER_SIZE
  CYLINDER_CATEGORY
  PRICE
  TAX
  DISCOUNT_PROMOTION
  DELIVERY_FEE
  REGION
  ZONE
  ROUTE
  LOCATION
  WAREHOUSE
  RETAIL_OUTLET
  VEHICLE
  MAINTENANCE_LOCATION
  DAMAGED_QUARANTINE_LOCATION
  STOCK_THRESHOLD
}

enum CustomerCategory {
  DOMESTIC
  COMMERCIAL
  INDUSTRIAL
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  BLACKLISTED
}

enum CylinderStatus {
  FILLED
  EMPTY
  EMPTY_AT_SELLING_POINT
  EMPTY_AT_WAREHOUSE
  EMPTY_IN_TRANSIT
  FILLED_IN_TRANSIT
  FILLED_AT_WAREHOUSE
  FILLED_AT_SELLING_POINT
  DAMAGED
  IN_TRANSIT
  RESERVED
  UNDER_MAINTENANCE
  WITH_CUSTOMER
  QUARANTINED
  SCRAPPED_WRITTEN_OFF
  LOST_OVERDUE
}

enum NonCodedCylinderIntakeStatus {
  PENDING_REVIEW
  TAGGING_PENDING
  TAGGED_APPROVED
  APPROVED_LINKED
  APPROVED_NEW_CYLINDER
  REJECTED
  ESCALATED
}

enum NonCodedCylinderCondition {
  GOOD
  DAMAGED
  LEAKING
  MISSING_VALVE
  WRONG_BRAND
  UNCLEAR_SERIAL
  NON_CODED
}

enum InventoryMovementType {
  OPENING_BALANCE
  RECEIPT
  ISSUE
  TRANSFER
  RETURN_FROM_CUSTOMER
  RETURN_FROM_VEHICLE
  ADJUSTMENT
  DAMAGED_QUARANTINE
  MAINTENANCE_TRANSFER
}

enum InventoryMovementStatus {
  REQUESTED
  APPROVED
  DISPATCHED
  RECEIVED
  COMPLETED
  VARIANCE_LOGGED
  REJECTED
}

enum SupplierReceiptStatus {
  DRAFT
  REVIEWED
  POSTED
}

enum SupplierReceiptCondition {
  FILLED
  EMPTY
  DAMAGED
  QUARANTINED
}

enum PlantTransferStatus {
  DRAFT
  DISPATCHED_TO_PLANT
  RECEIVED_AT_PLANT
  VARIANCE_LOGGED
  REFILLED
  RETURN_DISPATCHED
  COMPLETED
}

enum PlantTransferLineStatus {
  EXPECTED
  RECEIVED_AT_PLANT
  MISSING
  EXTRA
  DAMAGED
  REFILLED
  RETURNED_TO_WAREHOUSE
}

enum RefillBatchStatus {
  DRAFT
  QUALITY_CHECKED
  FILLED
}

enum QualityInspectionStatus {
  PENDING
  PASSED
  FAILED
}

enum PlantVarianceType {
  MISSING
  EXTRA
  DAMAGED
}

enum PlantVarianceStatus {
  OPEN
  RESOLVED
}

enum RefillOrderStatus {
  DRAFT
  CLOSED
  CANCELLED
}

enum PaymentMethod {
  CASH
  MPESA
  CARD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  FAILED
  REFUNDED
}

enum InvoiceSourceType {
  CUSTOMER_ORDER
  RETAIL_REFILL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum OrderChannel {
  MOBILE_APP
  WEB
  RSO
  MSO
  CALL_CENTRE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  ASSIGNED
  DISPATCHED
  DELIVERED
  CLOSED
  CANCELLED
}

enum FieldSaleStatus {
  CLOSED
  DISCREPANCY_REPORTED
}

enum DeliveryStatus {
  ASSIGNED
  LOADING_CONFIRMED
  CUSTOMER_ARRIVAL
  DELIVERED
  FAILED
  RETURNED
  EXCEPTION
}

enum FailedDeliveryReason {
  CUSTOMER_UNAVAILABLE
  DAMAGED_CYLINDER
  WRONG_LOCATION
  PAYMENT_ISSUE
  PARTIAL_DELIVERY
}

enum ReconciliationScope {
  RSO
  MSO
  WAREHOUSE
  SERVICE_CENTRE
}

enum ReconciliationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
  CLOSED
}

enum ReconciliationCountMode {
  SUMMARY
  SCAN
}

enum ReconciliationVarianceType {
  MISSING
  EXTRA
  DUPLICATE
  WRONG_LOCATION
  WRONG_STATUS
  OVERDUE_IN_TRANSIT
  STOCK_VARIANCE
  PAYMENT_VARIANCE
}

enum ReconciliationVarianceStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum CylinderMaintenanceStatus {
  NONE
  OPEN
  IN_PROGRESS
  CLEARED
  SCRAP_PLACEHOLDER
}

enum MaintenanceCaseStatus {
  OPEN
  INSPECTION_RECORDED
  QUARANTINED
  APPROVED_RETURN_TO_STOCK
  SCRAP_PLACEHOLDER
  CLOSED
}

enum InspectionResult {
  PASSED
  FAILED
  NEEDS_HYDRO_TEST
  UNSAFE
}

enum SafetyIncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationEventType {
  CUSTOMER_ORDER_CONFIRMATION
  DELIVERY_UPDATE
  RECEIPT_ISSUED
  LOW_STOCK_ALERT
  PENDING_DELIVERY_ALERT
  MAINTENANCE_ALERT
  EMERGENCY_RECALL
  SAFETY_WARNING
  REFILL_FOLLOW_UP
}

enum NotificationChannel {
  SMS
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum OfflineSyncItemType {
  ASSIGNED_DELIVERY_SNAPSHOT
  VEHICLE_STOCK_SNAPSHOT
  CUSTOMER_DRAFT
  DELIVERY_STATUS_DRAFT
  PROOF_OF_DELIVERY_DRAFT
  FIELD_SALE_DRAFT
}

enum OfflineSyncItemStatus {
  QUEUED
  SYNCED
  FAILED
  CONFLICT
}

enum IntegrationProviderType {
  SAP_ACCOUNTING
  PAYMENT_GATEWAY
  SMS_EMAIL
  BARCODE_RFID
  MAPS_GPS
}

enum ScanActionType {
  RECEIPT
  TRANSFER_DISPATCH
  TRANSFER_RECEIVE
  SALE
  CUSTOMER_RETURN
  NON_CODED_INTAKE
  REPORT_LOOKUP
  MOBILE_VERIFY
}

enum ScanResultStatus {
  PERMITTED
  CYLINDER_NOT_FOUND
  WRONG_LOCATION
  WRONG_STATUS
  BLOCKED_DAMAGED
  ALREADY_SCANNED
  INACTIVE
  FAILED
}

enum IntegrationLogStatus {
  QUEUED
  SUCCESS
  FAILED
  RETRY_QUEUED
}

enum SapPostingStatus {
  QUEUED
  POSTED
  FAILED
  RETRY_QUEUED
  MISMATCHED
}

enum SapSourceModule {
  SUPPLIER_RECEIPT
  INVENTORY_MOVEMENT
  FULL_CYLINDER_SALE
  REFILL_ORDER
  FIELD_SALE
  EMPTY_RETURN
  SCRAP_WRITE_OFF
}

enum UserSessionStatus {
  ACTIVE
  LOGGED_OUT
  EXPIRED
  REVOKED
}

enum AuditEventCategory {
  AUTH
  MASTER_DATA
  CUSTOMER
  INVENTORY
  APPROVAL
  ORDER
  DELIVERY
  BILLING
  PAYMENT
  RECONCILIATION
  COMPLIANCE
  INTEGRATION
  NOTIFICATION
  OFFLINE_SYNC
  SECURITY
  SYSTEM
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum CustomerComplaintType {
  GAS_LEAK
  DELIVERY_DELAY
  DAMAGED_CYLINDER
  PAYMENT_QUERY
  SERVICE_QUALITY
  OTHER
}

enum CustomerComplaintPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CustomerComplaintStatus {
  SUBMITTED
  IN_REVIEW
  ESCALATED
  RESOLVED
  CLOSED
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                               String                     @id @default(cuid())
  name                             String
  email                            String                     @unique
  passwordHash                     String
  roleId                           String
  locationId                       String?
  role                             Role                       @relation(fields: [roleId], references: [id])
  location                         Location?                  @relation(fields: [locationId], references: [id])
  auditLogs                        AuditLog[]
  cylinderHistoryEntries           CylinderHistory[]
  openingBalanceBatches            OpeningBalanceBatch[]
  requestedInventoryMovements      InventoryMovement[]        @relation("MovementRequestedBy")
  approvedInventoryMovements       InventoryMovement[]        @relation("MovementApprovedBy")
  dispatchedInventoryMovements     InventoryMovement[]        @relation("MovementDispatchedBy")
  receivedInventoryMovements       InventoryMovement[]        @relation("MovementReceivedBy")
  inventoryMovementHistoryEntries  InventoryMovementHistory[]
  createdSupplierReceipts          SupplierReceipt[]          @relation("SupplierReceiptCreatedBy")
  reviewedSupplierReceipts         SupplierReceipt[]          @relation("SupplierReceiptReviewedBy")
  postedSupplierReceipts           SupplierReceipt[]          @relation("SupplierReceiptPostedBy")
  createdPlantTransfers            PlantTransfer[]            @relation("PlantTransferCreatedBy")
  dispatchedPlantTransfers         PlantTransfer[]            @relation("PlantTransferDispatchedBy")
  plantReceivedTransfers           PlantTransfer[]            @relation("PlantTransferReceivedBy")
  plantReturnDispatchedTransfers   PlantTransfer[]            @relation("PlantTransferReturnDispatchedBy")
  plantReturnReceivedTransfers     PlantTransfer[]            @relation("PlantTransferReturnReceivedBy")
  createdRefillBatches             RefillBatch[]              @relation("RefillBatchCreatedBy")
  checkedRefillBatches             RefillBatch[]              @relation("RefillBatchQualityCheckedBy")
  createdPlantVarianceCases        PlantVarianceCase[]        @relation("PlantVarianceCreatedBy")
  refillOrders                     RefillOrder[]
  refillPayments                   Payment[]
  fullCylinderSales                FullCylinderSale[]
  customerOrders                   CustomerOrder[]
  customerOrderHistoryEntries      CustomerOrderHistory[]
  fieldSales                       FieldSale[]
  assignedDeliveries               Delivery[]                 @relation("DeliveryAssignedUser")
  createdDeliveries                Delivery[]                 @relation("DeliveryCreatedBy")
  deliveryHistoryEntries           DeliveryHistory[]
  createdInvoices                  Invoice[]                  @relation("InvoiceCreatedBy")
  recordedBillingPayments          BillingPayment[]           @relation("BillingPaymentRecordedBy")
  reconciliations                  DailyReconciliation[]      @relation("ReconciliationOwner")
  createdReconciliations           DailyReconciliation[]      @relation("ReconciliationCreatedBy")
  reviewedReconciliations          DailyReconciliation[]      @relation("ReconciliationReviewedBy")
  createdMaintenanceCases          MaintenanceCase[]          @relation("MaintenanceCaseCreatedBy")
  inspectedMaintenanceCases        MaintenanceCase[]          @relation("MaintenanceCaseInspectedBy")
  approvedMaintenanceCases         MaintenanceCase[]          @relation("MaintenanceCaseApprovedBy")
  createdSafetyIncidents           SafetyIncident[]           @relation("SafetyIncidentCreatedBy")
  createdNotifications             Notification[]             @relation("NotificationCreatedBy")
  createdCustomerComplaints        CustomerComplaint[]        @relation("CustomerComplaintCreatedBy")
  createdCustomerCylinderCustodies CustomerCylinderCustody[]  @relation("CustomerCylinderCustodyCreatedBy")
  createdNonCodedCylinderIntakes   NonCodedCylinderIntake[]   @relation("NonCodedCylinderIntakeCreatedBy")
  reviewedNonCodedCylinderIntakes  NonCodedCylinderIntake[]   @relation("NonCodedCylinderIntakeReviewedBy")
  createdReconciliationVariances   ReconciliationVarianceCase[] @relation("ReconciliationVarianceCreatedBy")
  resolvedReconciliationVariances  ReconciliationVarianceCase[] @relation("ReconciliationVarianceResolvedBy")
  scanEvents                       ScanEvent[]
  offlineSyncItems                 OfflineSyncItem[]
  integrationLogs                  IntegrationLog[]
  sapPostingQueues                 SapPostingQueue[]
  sessions                         UserSession[]
  createdAt                        DateTime                   @default(now())
  updatedAt                        DateTime                   @updatedAt
}

model Location {
  id        String       @id @default(cuid())
  name      String
  code      String       @unique
  type      LocationType
  users     User[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model LpgSku {
  id          String   @id @default(cuid())
  name        String   @unique
  capacityKg  Int
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String             @id @default(cuid())
  action     String
  category   AuditEventCategory @default(SYSTEM)
  severity   AuditSeverity      @default(INFO)
  details    String
  entityType String?
  entityId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  userId     String?
  user       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime           @default(now())

  @@index([category])
  @@index([severity])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model UserSession {
  id             String            @id @default(cuid())
  sessionTokenId String            @unique
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         UserSessionStatus @default(ACTIVE)
  ipAddress      String?
  userAgent      String?
  deviceLabel    String?
  mfaVerified    Boolean           @default(false)
  mfaPlaceholder String?
  lastSeenAt     DateTime          @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([lastSeenAt])
}

model SecurityControlSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  value       String
  description String
  isEnabled   Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model MasterDataRecord {
  id                          String                    @id @default(cuid())
  type                        MasterDataType
  code                        String
  name                        String
  description                 String?
  isActive                    Boolean                   @default(true)
  amount                      Decimal?                  @db.Decimal(12, 2)
  rate                        Decimal?                  @db.Decimal(5, 2)
  capacityKg                  Int?
  threshold                   Int?
  parentId                    String?
  parent                      MasterDataRecord?         @relation("MasterDataHierarchy", fields: [parentId], references: [id])
  children                    MasterDataRecord[]        @relation("MasterDataHierarchy")
  skuCylinders                Cylinder[]                @relation("CylinderSku")
  locationCylinders           Cylinder[]                @relation("CylinderLocation")
  expectedScanEvents          ScanEvent[]               @relation("ScanEventExpectedLocation")
  scannedScanEvents           ScanEvent[]               @relation("ScanEventScannedLocation")
  openingBalanceSkuLines      OpeningBalanceLine[]      @relation("OpeningBalanceSku")
  openingBalanceLocationLines OpeningBalanceLine[]      @relation("OpeningBalanceLocation")
  movementSkus                InventoryMovement[]       @relation("MovementSku")
  sourceMovements             InventoryMovement[]       @relation("MovementSourceLocation")
  destinationMovements        InventoryMovement[]       @relation("MovementDestinationLocation")
  refillOrderSkus             RefillOrder[]             @relation("RefillOrderSku")
  refillOrderLocations        RefillOrder[]             @relation("RefillOrderLocation")
  fullCylinderSaleSkus        FullCylinderSale[]        @relation("FullCylinderSaleSku")
  fullCylinderSaleLocations   FullCylinderSale[]        @relation("FullCylinderSaleLocation")
  orderDeliveryZones          CustomerOrder[]           @relation("OrderDeliveryZone")
  orderItemSkus               CustomerOrderItem[]       @relation("OrderItemSku")
  fieldSaleSkus               FieldSale[]               @relation("FieldSaleSku")
  fieldSaleVehicles           FieldSale[]               @relation("FieldSaleVehicle")
  fieldSaleRoutes             FieldSale[]               @relation("FieldSaleRoute")
  fieldSaleZones              FieldSale[]               @relation("FieldSaleZone")
  deliveryRoutes              Delivery[]                @relation("DeliveryRoute")
  deliveryZones               Delivery[]                @relation("DeliveryZone")
  deliveryVehicles            Delivery[]                @relation("DeliveryVehicle")
  reconciliationLocations     DailyReconciliation[]     @relation("ReconciliationLocation")
  reconciliationCountSkus     ReconciliationCountLine[] @relation("ReconciliationCountSku")
  reconciliationVarianceSkus  ReconciliationVarianceCase[] @relation("ReconciliationVarianceSku")
  reconciliationVarianceLocations ReconciliationVarianceCase[] @relation("ReconciliationVarianceLocation")
  reconciliationVarianceExpectedLocations ReconciliationVarianceCase[] @relation("ReconciliationVarianceExpectedLocation")
  reconciliationVarianceScannedLocations ReconciliationVarianceCase[] @relation("ReconciliationVarianceScannedLocation")
  complaintLocations          CustomerComplaint[]       @relation("CustomerComplaintLocation")
  supplierReceipts            SupplierReceipt[]         @relation("SupplierReceiptWarehouse")
  sourcePlantTransfers        PlantTransfer[]           @relation("PlantTransferSourceLocation")
  plantTransferDestinations   PlantTransfer[]           @relation("PlantTransferPlantLocation")
  returnPlantDestinations     PlantTransfer[]           @relation("PlantTransferReturnDestination")
  refillBatches               RefillBatch[]             @relation("RefillBatchPlantLocation")
  custodyIssueLocations       CustomerCylinderCustody[] @relation("CustodyIssueLocation")
  custodyReturnLocations      CustomerCylinderCustody[] @relation("CustodyReturnLocation")
  nonCodedCylinderIntakes     NonCodedCylinderIntake[]  @relation("NonCodedIntakeLocation")
  metadata                    Json?
  sapMaterialCode             String?
  sapPlantCode                String?
  sapStorageLocationCode      String?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt

  @@unique([type, code])
  @@index([type, isActive])
}

model Customer {
  id                      String                    @id @default(cuid())
  name                    String
  phone                   String                    @unique
  email                   String?                   @unique
  proofReference          String                    @unique
  kraPin                  String?
  sapCustomerCode         String?
  category                CustomerCategory
  address                 String
  latitude                Decimal?                  @db.Decimal(9, 6)
  longitude               Decimal?                  @db.Decimal(9, 6)
  status                  CustomerStatus            @default(ACTIVE)
  creditLimit             Decimal?                  @db.Decimal(12, 2)
  notes                   String?
  documentPlaceholder     String?
  refillOrders            RefillOrder[]
  customerOrders          CustomerOrder[]
  fieldSales              FieldSale[]
  fullCylinderSales       FullCylinderSale[]
  invoices                Invoice[]
  billingPayments         BillingPayment[]
  complaints              CustomerComplaint[]
  cylinderCustodies       CustomerCylinderCustody[]
  nonCodedCylinderIntakes NonCodedCylinderIntake[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@index([name])
  @@index([status])
  @@index([category])
}

model CustomerComplaint {
  id                    String                    @id @default(cuid())
  complaintNumber       String                    @unique
  customerId            String?
  customer              Customer?                 @relation(fields: [customerId], references: [id], onDelete: SetNull)
  locationId            String?
  location              MasterDataRecord?         @relation("CustomerComplaintLocation", fields: [locationId], references: [id], onDelete: SetNull)
  type                  CustomerComplaintType
  priority              CustomerComplaintPriority @default(MEDIUM)
  status                CustomerComplaintStatus   @default(SUBMITTED)
  description           String
  attachmentPlaceholder String?
  escalationNotes       String?
  createdById           String?
  createdBy             User?                     @relation("CustomerComplaintCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([customerId])
  @@index([locationId])
  @@index([type])
  @@index([priority])
  @@index([status])
  @@index([createdAt])
}

model CustomerOrder {
  id                   String                 @id @default(cuid())
  orderNumber          String                 @unique
  customerId           String
  customer             Customer               @relation(fields: [customerId], references: [id])
  status               OrderStatus            @default(PENDING)
  channel              OrderChannel
  isPriority           Boolean                @default(false)
  deliveryZoneId       String?
  deliveryZone         MasterDataRecord?      @relation("OrderDeliveryZone", fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  expectedDeliveryDate DateTime?
  notes                String?
  deliveryPlaceholder  String?
  createdById          String?
  createdBy            User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items                CustomerOrderItem[]
  historyEntries       CustomerOrderHistory[]
  delivery             Delivery?
  invoice              Invoice?               @relation("OrderInvoice")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([channel])
  @@index([isPriority])
  @@index([deliveryZoneId])
}

model CustomerOrderItem {
  id        String           @id @default(cuid())
  orderId   String
  order     CustomerOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  skuId     String
  sku       MasterDataRecord @relation("OrderItemSku", fields: [skuId], references: [id])
  quantity  Int
  notes     String?
  createdAt DateTime         @default(now())

  @@index([orderId])
  @@index([skuId])
}

model CustomerOrderHistory {
  id          String        @id @default(cuid())
  orderId     String
  order       CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  action      String
  details     String
  changedById String?
  changedBy   User?         @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model Delivery {
  id                   String                @id @default(cuid())
  deliveryNumber       String                @unique
  orderId              String                @unique
  order                CustomerOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  routeId              String?
  route                MasterDataRecord?     @relation("DeliveryRoute", fields: [routeId], references: [id], onDelete: SetNull)
  zoneId               String?
  zone                 MasterDataRecord?     @relation("DeliveryZone", fields: [zoneId], references: [id], onDelete: SetNull)
  vehicleId            String?
  vehicle              MasterDataRecord?     @relation("DeliveryVehicle", fields: [vehicleId], references: [id], onDelete: SetNull)
  assignedUserId       String?
  assignedUser         User?                 @relation("DeliveryAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  driverName           String?
  status               DeliveryStatus        @default(ASSIGNED)
  failedReason         FailedDeliveryReason?
  otp                  String?
  signaturePlaceholder String?
  photoPlaceholder     String?
  gpsLatitude          Decimal?              @db.Decimal(9, 6)
  gpsLongitude         Decimal?              @db.Decimal(9, 6)
  customerRemarks      String?
  exceptionNotes       String?
  loadingConfirmedAt   DateTime?
  customerArrivedAt    DateTime?
  deliveredAt          DateTime?
  failedAt             DateTime?
  returnedAt           DateTime?
  createdById          String?
  createdBy            User?                 @relation("DeliveryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  historyEntries       DeliveryHistory[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([status])
  @@index([routeId])
  @@index([zoneId])
  @@index([vehicleId])
  @@index([assignedUserId])
}

model DeliveryHistory {
  id          String          @id @default(cuid())
  deliveryId  String
  delivery    Delivery        @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  fromStatus  DeliveryStatus?
  toStatus    DeliveryStatus
  action      String
  details     String
  changedById String?
  changedBy   User?           @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())

  @@index([deliveryId])
  @@index([createdAt])
}

model Cylinder {
  id                      String                      @id @default(cuid())
  serialNumber            String                      @unique
  barcode                 String?                     @unique
  factorySerialNo         String?                     @unique
  qrCode                  String?                     @unique
  cylinderSizeKg          Int?
  manufacturer            String?
  skuId                   String
  sku                     MasterDataRecord            @relation("CylinderSku", fields: [skuId], references: [id])
  manufactureDate         DateTime?
  inspectionDueDate       DateTime?
  currentLocationId       String
  currentLocation         MasterDataRecord            @relation("CylinderLocation", fields: [currentLocationId], references: [id])
  status                  CylinderStatus
  activeStatus            Boolean                     @default(true)
  blockedReason           String?
  companyOwned            Boolean                     @default(true)
  notes                   String?
  historyEntries          CylinderHistory[]
  movementLines           InventoryMovementCylinder[]
  supplierReceiptLines    SupplierReceiptLine[]
  plantTransferLines      PlantTransferLine[]
  plantVarianceCases      PlantVarianceCase[]
